library IEEE;
use IEEE.STD_LOGIC_1164.ALL;

entity bombom01 is
   port (
      reset, clk       : in  std_logic;

      -- "Moeda_in" do diagrama: sensor detecta o valor (em centavos) e avisa com um pulso
      moeda_valor       : in  integer range 0 to 999;  -- valor lido pelo sensor de moedas
      moeda_inserida    : in  std_logic;                -- sobe por 1 ciclo quando uma moeda chega

      sel_produto       : in  std_logic_vector(2 downto 0);  -- botão de produto ("Tipo_do_salgado")
      confirma_selecao  : in  std_logic;                     -- botão confirmando a escolha
      desiste           : in  std_logic;                     -- botão de desistência

      estoque           : in  std_logic_vector(4 downto 0);  -- 1 bit por produto: '1' = tem estoque

      moedas_aceitas        : out std_logic_vector(2 downto 0);  -- painel: aceita 0,25 / 0,50 / 1,00
      aviso_sem_estoque      : out std_logic;                     -- acende se o produto escolhido acabou
      moeda_invalida         : out std_logic;                     -- sobe por 1 ciclo: moeda não reconhecida, não soma
      libera_salgado         : out std_logic;                     -- libera o produto comprado
      libera_troco           : out std_logic;                     -- libera troco (pagou a mais)
      libera_todas_as_moedas : out std_logic;                     -- desistência: devolve tudo que foi depositado

      display_reais      : out std_logic_vector(6 downto 0);  -- 7 segmentos: parte inteira (reais)
      display_decimo      : out std_logic_vector(6 downto 0);  -- 7 segmentos: primeiro decimal (dezena de centavo)

      preco  : out integer range 0 to 999;  -- preço do produto escolhido, informativo
      saldo  : out integer range 0 to 999;  -- soma depositada até agora, informativo
      troco  : out integer range 0 to 999   -- valor a devolver, se pagou a mais
   );
end bombom01;

architecture arc_bombons of bombom01 is

   constant ACEITA : std_logic_vector(2 downto 0) := "111";  -- as 3 moedas válidas, sempre aceitas

   -- os 4 estados da máquina: igual à "Unidade de Controle" do diagrama
   type estado_t is (AGUARDANDO, AVISO, RECEBENDO, LIBERANDO);
   signal estado_atual : estado_t;

   signal preco_atual : integer range 0 to 999;
   signal saldo_atual : integer range 0 to 999;

   -- "Lógica auxiliar" do diagrama: decodifica um dígito (0-9) para os 7 segmentos
   function seg7(digito : integer range 0 to 9) return std_logic_vector is
   begin
      case digito is
         when 0 => return "1000000";
         when 1 => return "1111001";
         when 2 => return "0100100";
         when 3 => return "0110000";
         when 4 => return "0011001";
         when 5 => return "0010010";
         when 6 => return "0000010";
         when 7 => return "1111000";
         when 8 => return "0000000";
         when 9 => return "0010000";
      end case;
   end function;

begin

   moedas_aceitas <= ACEITA;  -- saída fixa, só para o painel

   -- tabela de produtos: código de 3 bits -> preço (em centavos)
   process (sel_produto)
   begin
      case sel_produto is
         when "000"  => preco_atual <= 250;  -- Batata frita grande: 2,50
         when "001"  => preco_atual <= 150;  -- Batata frita média:  1,50
         when "010"  => preco_atual <= 75;   -- Batata frita pequena: 0,75
         when "011"  => preco_atual <= 350;  -- Tortilha grande:     3,50
         when others => preco_atual <= 200;  -- Tortilha pequena:    2,00
      end case;
   end process;

   preco <= preco_atual;

   -- mostra o saldo acumulado nos dois displays: reais e primeiro decimal de centavos
   display_reais  <= seg7(saldo_atual / 100);
   display_decimo <= seg7((saldo_atual mod 100) / 10);

   process (clk)
      variable saldo_tmp : integer range 0 to 999;
      variable tem_estoque : std_logic;
   begin
      if (reset = '1') then
         estado_atual           <= AGUARDANDO;
         saldo_atual            <= 0;
         libera_salgado         <= '0';
         libera_troco           <= '0';
         libera_todas_as_moedas <= '0';
         aviso_sem_estoque      <= '0';
         moeda_invalida         <= '0';
         troco                  <= 0;

      elsif (clk = '1' and clk'event) then

         -- por padrão, a cada clock, nenhuma dessas saídas fica ativa; só sobem no caso certo
         libera_salgado         <= '0';
         libera_troco           <= '0';
         libera_todas_as_moedas <= '0';
         aviso_sem_estoque      <= '0';
         moeda_invalida         <= '0';

         case estado_atual is

            when AGUARDANDO =>  -- cliente ainda está escolhendo o produto
               if (confirma_selecao = '1') then
                  tem_estoque := estoque(to_integer(unsigned(sel_produto)));
                  if (tem_estoque = '1') then
                     estado_atual <= RECEBENDO;   -- item 4: tem estoque, pode receber moedas
                  else
                     estado_atual <= AVISO;       -- item 3: sem estoque, emite aviso
                  end if;
               end if;

            when AVISO =>  -- item 3: aviso de falta de estoque
               aviso_sem_estoque <= '1';
               if (confirma_selecao = '1') then
                  estado_atual <= AGUARDANDO;  -- cliente escolhe outro produto
               end if;

            when RECEBENDO =>  -- item 4/5/6/7: recebendo moedas, pode desistir a qualquer momento
               saldo_tmp := saldo_atual;

               if (desiste = '1') then
                  -- item 6: desistência, devolve tudo o que foi depositado
                  libera_todas_as_moedas <= '1';
                  troco                  <= saldo_tmp;
                  saldo_tmp := 0;
                  estado_atual <= AGUARDANDO;

               elsif (moeda_inserida = '1') then
                  if (moeda_valor = 25 or moeda_valor = 50 or moeda_valor = 100) then
                     saldo_tmp := saldo_tmp + moeda_valor;  -- item 2: moeda válida, soma
                  else
                     moeda_invalida <= '1';  -- item 5: moeda inválida, não soma, passa direto
                  end if;

                  if (saldo_tmp >= preco_atual) then
                     estado_atual <= LIBERANDO;
                  end if;
               end if;

               saldo_atual <= saldo_tmp;

            when LIBERANDO =>  -- soma completada: libera produto e troco, se houver
               libera_salgado <= '1';
               if (saldo_atual > preco_atual) then
                  libera_troco <= '1';
                  troco        <= saldo_atual - preco_atual;
               else
                  troco <= 0;
               end if;
               saldo_atual  <= 0;
               estado_atual <= AGUARDANDO;

         end case;
      end if;
   end process;

   saldo <= saldo_atual;

end arc_bombons;
